---
import ThemeToggle from '~/components/react/ThemeToggle';
import PaletteButton from '~/components/react/PaletteButton';
import { counts, sessionDates } from '~/lib/content';
import { standing, pct } from '~/lib/progress';
import { prep } from '../../prep.config';

interface Props { track: string; }
const { track } = Astro.props;

const c = await counts();
const dates = await sessionDates();
const s = standing(dates);

const badge: Record<string, string | number> = {
  plan: `${prep.totalWeeks}w`,
  coding: c.problems,
  internals: c.labs,
  open: c.openActive,
  sessions: c.sessions,
};

const topicPct = pct(c.problems, prep.currentTopic.target);
---
<aside class="rail">
  <a class="brand" href="/">
    {prep.title}
    <span>Week {s.week} of {prep.totalWeeks} · {prep.role}</span>
  </a>

  <p class="rail-h">Tracks</p>
  <ul class="nav">
    {prep.tracks.map((t) => (
      <li>
        <a href={t.href} aria-current={t.id === track ? 'page' : undefined}>
          <span class="k">{t.k}</span>{t.label}
          {badge[t.id] !== undefined && <span class="ct">{badge[t.id]}</span>}
        </a>
      </li>
    ))}
  </ul>

  <div class="railmeter">
    <div class="rm-top">
      <span>{prep.currentTopic.name}</span>
      <span>{c.problems} traced</span>
    </div>
    <div class="rm-bar"><div class="rm-fill" style={`width:${topicPct}%`}></div></div>
  </div>

  <div class="railmeter">
    <div class="rm-top">
      <span>{prep.totalWeeks}-week plan</span>
      <span>day {s.sessionOrdinal}</span>
    </div>
    <div class="rm-bar"><div class="rm-fill" style={`width:${s.elapsedPct}%`}></div></div>
  </div>

  <div class="railtools">
    <PaletteButton client:idle />
    <ThemeToggle client:idle />
  </div>
</aside>
