---
/**
 * The mark traces.
 *
 * A four-cell array with the active cell stepping through it — the same
 * move the trace player makes, at 28px. Cells settle behind it the way
 * `ok` cells do in a real trace. Frozen on the first cell when the
 * viewer has asked for reduced motion.
 */
---
<span class="logo" aria-hidden="true">
  <svg viewBox="0 0 32 32" width="30" height="30" role="img">
    <defs>
      <linearGradient id="lg-body" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="var(--lg-a)" />
        <stop offset="100%" stop-color="var(--lg-b)" />
      </linearGradient>
      <linearGradient id="lg-spec" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#fff" stop-opacity=".45" />
        <stop offset="55%" stop-color="#fff" stop-opacity="0" />
      </linearGradient>
      <linearGradient id="lg-sheen" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#fff" stop-opacity="0" />
        <stop offset="50%" stop-color="#fff" stop-opacity=".22" />
        <stop offset="100%" stop-color="#fff" stop-opacity="0" />
      </linearGradient>
      <clipPath id="lg-clip"><rect width="32" height="32" rx="9.5" /></clipPath>
    </defs>

    <rect width="32" height="32" rx="9.5" fill="url(#lg-body)" />
    <rect width="32" height="32" rx="9.5" fill="url(#lg-spec)" />

    <g class="cells">
      <rect x="7"  y="7"  width="7" height="7" rx="2.2" />
      <rect x="18" y="7"  width="7" height="7" rx="2.2" />
      <rect x="18" y="18" width="7" height="7" rx="2.2" />
      <rect x="7"  y="18" width="7" height="7" rx="2.2" />
    </g>

    <rect class="cursor" x="7" y="7" width="7" height="7" rx="2.2" />

    <g clip-path="url(#lg-clip)">
      <rect class="sheen" x="-34" y="-6" width="20" height="44" fill="url(#lg-sheen)" />
    </g>

    <rect width="32" height="32" rx="9.5" fill="none" stroke="#fff" stroke-opacity=".22" />
  </svg>
</span>

<style>
  .logo {
    --lg-a: var(--accent);
    --lg-b: color-mix(in srgb, var(--accent) 35%, var(--b3));
    display: block;
    line-height: 0;
    flex: none;
    border-radius: 10px;
    box-shadow: 0 3px 14px color-mix(in srgb, var(--accent) 42%, transparent);
    transition: transform var(--med) var(--spring), box-shadow var(--med) var(--ease);
  }

  .cells rect { fill: var(--on-accent); fill-opacity: .34; }

  .cursor {
    fill: var(--on-accent);
    /* Steps clockwise through the four cells, pausing on each. */
    animation: trace 4.4s var(--ease) infinite;
  }

  @keyframes trace {
      0%,  17% { transform: translate(0, 0);     }
     25%,  42% { transform: translate(11px, 0);  }
     50%,  67% { transform: translate(11px, 11px); }
     75%,  92% { transform: translate(0, 11px);  }
    100%       { transform: translate(0, 0);     }
  }

  .sheen { animation: sheen 4.4s var(--ease) infinite; }
  @keyframes sheen {
    0%, 62%  { transform: translateX(0)    rotate(0deg); }
    82%,100% { transform: translateX(78px) rotate(0deg); }
  }

  /* the whole mark answers the pointer */
  :global(.brand:hover) .logo {
    transform: scale(1.07) rotate(-3deg);
    box-shadow: 0 5px 20px color-mix(in srgb, var(--accent) 58%, transparent);
  }
  :global(.brand:hover) .cursor { animation-duration: 1.9s; }
  :global(.brand:hover) .sheen  { animation-duration: 1.9s; }

  @media (prefers-reduced-motion: reduce) {
    .cursor, .sheen { animation: none; }
    .sheen { opacity: 0; }
  }
</style>
