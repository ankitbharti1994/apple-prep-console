---
import TracePlayer from '~/components/react/TracePlayer';
import type { Problem } from '~/lib/trace';

interface Props { problem: Problem; }
const { problem: p } = Astro.props;
const frames = p.trace();
const lcHref = p.lcSlug ? `https://leetcode.com/problems/${p.lcSlug}/` : null;
---
<article class="card" id={`p${p.n}`}>
  <div class="card-h">
    <div class="no">Question {p.n}{p.isNew ? ' · new' : ''}</div>
    <h2>{p.title}</h2>
    <div class="tags">
      <span class:list={['tag', p.difficulty.toLowerCase()]}>{p.difficulty}</span>
      {lcHref && (
        <a class="tag lc" href={lcHref} target="_blank" rel="noopener">
          LeetCode {p.lc} ↗
        </a>
      )}
      {p.tags?.map((t) => <span class="tag">{t}</span>)}
    </div>
  </div>

  <TracePlayer client:load frames={frames} code={p.code} arrLabel={p.arrLabel ?? 'nums'} />

  <div class="foot">
    <span class="cx">{p.complexity}</span>
    {p.notes && p.notes.length > 0 && (
      <ul>{p.notes.map((n) => <li>{n}</li>)}</ul>
    )}
  </div>
</article>
