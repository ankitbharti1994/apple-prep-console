---
/**
 * Where you are, with room to say it properly.
 * Both figures are derived — nothing here is written down anywhere.
 */
import { counts, sessionDates } from '~/lib/content';
import { standing, pct } from '~/lib/progress';
import { prep } from '../../prep.config';

const c = await counts();
const s = standing(await sessionDates());

const topicPct = pct(c.problems, prep.currentTopic.target);
const rows = [
  {
    label: prep.currentTopic.name,
    // Past the target the "n of m" framing reads as broken rather than done.
    value:
      c.problems >= prep.currentTopic.target
        ? `${c.problems} traced`
        : `${c.problems} of ${prep.currentTopic.target} traced`,
    pct: topicPct,
    note:
      c.problems > prep.currentTopic.target
        ? `target of ${prep.currentTopic.target} passed — topic 2 not yet set`
        : c.problems === prep.currentTopic.target
          ? 'target met'
          : `${prep.currentTopic.target - c.problems} to go`,
  },
  {
    label: 'sessions run',
    value: `day ${s.sessionOrdinal} of ${prep.plannedSessions}+`,
    pct: s.elapsedPct,
    note: s.inOverrun
      ? `week ${s.week} · past the planned ${prep.plannedWeeks}, runway to ${prep.maxWeeks}`
      : `week ${s.week} of ${prep.plannedWeeks} · runway to ${prep.maxWeeks}`,
  },
];
---
<div class="standing">
  {rows.map((r) => (
    <div class="st-row">
      <div class="st-head">
        <span class="st-lbl">{r.label}</span>
        <span class="st-val">{r.value}</span>
      </div>
      <div class="st-bar"><i style={`width:${r.pct}%`}></i></div>
      <div class="st-foot"><span>{r.note}</span><b>{r.pct}%</b></div>
    </div>
  ))}
</div>
