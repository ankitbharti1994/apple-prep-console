---
import Shell from '~/layouts/Shell.astro';
import ReviewQueue from '~/components/react/ReviewQueue';
import { problems } from '~/data/problems';
import { getCollection } from 'astro:content';

const problemRows = problems.map((p) => ({
  n: p.n,
  title: p.title,
  traced: p.traced ?? null,
  href: `/coding/${p.n}`,
}));

const openItemRows = (await getCollection('openItems')).map((o) => ({
  id: o.id,
  title: o.data.title,
  kind: o.data.kind,
  status: o.data.status,
  opened: o.data.opened,
  closed: o.data.closed,
}));

const nextStepRows = (await getCollection('nextSteps')).map((s) => ({
  title: s.data.title,
  done: s.data.done,
}));
---
<Shell title="Review" track="review" description="Daily spaced-repetition queue for problems, open items, and next steps.">
  <p class="eyebrow">Track 06 · daily queue</p>
  <h1>Today's review,<br /><em>scheduled by the data</em>.</h1>
  <p class="lede">
    Spaced-repetition prompts for traced problems, follow-ups on closed open items,
    and the next steps still in flight.
  </p>

  <ReviewQueue
    client:only="react"
    problems={problemRows}
    openItems={openItemRows}
    nextSteps={nextStepRows}
  />
</Shell>
