---
import Shell from '~/layouts/Shell.astro';
import { buildReviewQueue } from '~/lib/review';
import { todayISO, formatShort } from '~/lib/progress';
import { prep } from '../../prep.config';

const today = todayISO();
const q = await buildReviewQueue(today);
const { due, upcoming, counts } = q;
---
<Shell title="Review" track="review" description="Daily spaced-repetition queue for problems, open items, and next steps.">
  <p class="eyebrow">Track 06 · daily queue</p>
  <h1>Today's review,<br /><em>scheduled by the data</em>.</h1>
  <p class="lede">
    Spaced-repetition prompts for traced problems, follow-ups on closed open items,
    and the next steps still in flight.
  </p>

  <div class="metrics">
    <div class="metric">
      <div class="lb">Due today</div>
      <div class="vv">{counts.due}</div>
      <div class="sub">across all tracks</div>
    </div>
    <div class="metric">
      <div class="lb">Problems</div>
      <div class="vv">{counts.problems}</div>
      <div class="sub">at review intervals</div>
    </div>
    <div class="metric">
      <div class="lb">Open items</div>
      <div class="vv">{counts.open}</div>
      <div class="sub">due or overdue</div>
    </div>
    <div class="metric">
      <div class="lb">Next steps</div>
      <div class="vv">{counts.nextSteps}</div>
      <div class="sub">still in flight</div>
    </div>
  </div>

  {due.length > 0 ? (
    <>
      <h2 class="sec">Due today · {formatShort(today)}</h2>
      <table class="ptable">
        <thead>
          <tr><th>Kind</th><th>What</th><th>Why it's here</th></tr>
        </thead>
        <tbody>
          {due.map((item) => (
            <tr>
              <td><span class="tag">{item.kind}</span></td>
              <td><a href={item.href}>{item.title}</a></td>
              <td>{item.reason}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  ) : (
    <p class="stripnote">
      Nothing scheduled for today. The queue refreshes as problems age and open items move.
    </p>
  )}

  {upcoming.length > 0 && (
    <>
      <h2 class="sec">Next 14 days</h2>
      <table class="ptable">
        <thead>
          <tr><th>Due</th><th>Kind</th><th>What</th><th>Why it's coming</th></tr>
        </thead>
        <tbody>
          {upcoming.map((item) => (
            <tr>
              <td>{formatShort(item.due)}</td>
              <td><span class="tag">{item.kind}</span></td>
              <td><a href={item.href}>{item.title}</a></td>
              <td>{item.reason}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  )}

  <div class="colophon">
    <span>{prep.currentTopic.name} · target {prep.currentTopic.target}</span>
    <span>Problem review intervals: 1, 3, 7, 14, 30, 60 days</span>
  </div>
</Shell>
