---
import Shell from '~/layouts/Shell.astro';
import { planPhases } from '~/lib/content';
import { weekOf, weekStart, formatShort, todayISO, isoWeekday } from '~/lib/progress';
import { prep } from '../../prep.config';

const phases = (await planPhases()).map((p) => p.data);
const today = todayISO();
const curWeek = weekOf(today);
const started = today >= prep.startDate;
// No completion state. Past the planned 12 weeks is overrun, not done —
// the 1 Sep revision made the date the flexible variable.
const overrun = curWeek > prep.plannedWeeks;

const inPhase = (w: number, p: { weeks: readonly [number, number] }) =>
  w >= p.weeks[0] && p.weeks[1] >= w;
const phaseOfWeek = (w: number) => phases.find((p) => inPhase(w, p));
const isCurrentPhase = (p: { weeks: readonly [number, number] }) =>
  started && inPhase(curWeek, p);
const band = (n: number) => `var(--p${n})`;

// "Where you are" — computed, not typed.
const cur = phaseOfWeek(curWeek);
const dow = isoWeekday(today);
const slotIndex = dow <= 5 ? 0 : dow === 6 ? 1 : 2;
const slot = cur?.blocks[slotIndex] ?? cur?.blocks[0];
---
<Shell title="Plan" track="plan" description="The twelve-week plan to the Apple loop.">
  <p class="eyebrow">
    Track 01 · from {formatShort(prep.startDate)} 2026 · {prep.plannedWeeks}–{prep.maxWeeks} weeks · {prep.locations.join(', ')}
  </p>
  <h1>Twelve weeks,<br /><em>sixteen if needed</em>.</h1>
  <p class="lede">
    Weekday mornings 6:00–7:30, Saturday deep work, Sunday review. Four phases, each
    ramping one track while keeping the last one warm.
  </p>

  <div class="sourcenote">
    <b>Where you are:</b>{' '}
    {!started && <span>The plan starts {formatShort(prep.startDate)} 2026.</span>}
    {started && cur && slot && (
      <span>
        Week <b>{curWeek}</b> of {prep.plannedWeeks} — phase {cur.id}, {cur.title}. Today is a{' '}
        <b>{slot.name.toLowerCase()}</b> day ({slot.slot}).
        {overrun && (
          <> Past the planned {prep.plannedWeeks} weeks and inside the runway to {prep.maxWeeks} — that is overrun, not completion.</>
        )}
      </span>
    )}
  </div>

  <div class="rev closed" style="margin:0 0 26px">
    <h4>Revised 1 September 2026 — the date became the flexible variable</h4>
    <p><span class="resolved">standing change</span></p>
    <p>
      Twelve weeks of <em>content</em> on a runway of up to sixteen. Phase boundaries are unchanged
      and nothing in the daily structure moves — weekday mornings 6:00–7:30, Saturday build block,
      Sunday checkpoint.
    </p>
    <ul>
      <li>First return to DSA after a long gap, and the first unbroken two-week run. Problems are
        taking longer than the plan assumed, and that is being treated as <b>information rather than
        failure</b>.</li>
      <li><b>The two-problem test is retired, not deferred.</b> It measured throughput, and throughput
        is no longer the goal — continuing to log it accumulates debt against a target no longer held.</li>
      <li><b>The daily cold-recall check does not relax.</b> A longer runway widens the gap between
        learning something and needing it, which makes the check more necessary, not less. Sixteen
        weeks without it is sixteen weeks of clarity that does not survive.</li>
      <li>The metric swap is the substantive part: <em>weeks remaining</em> counted down toward a
        deadline, <em>days unbroken</em> counts up on the thing actually being optimised for.</li>
    </ul>
  </div>

  <div class="railhead">
    <span>Week 1 · {formatShort(prep.startDate)}</span>
    <span>Week {prep.plannedWeeks} · then up to {prep.maxWeeks}</span>
  </div>

  <div class="weeks">
    {Array.from({ length: prep.plannedWeeks }, (_, i) => i + 1).map((w) => {
      const p = phaseOfWeek(w)!;
      return (
        <a
          class:list={['wk', { done: w < curWeek, now: w === curWeek }]}
          style={`--band:${band(p.band)}`}
          href={`#phase-${p.id}`}
          title={`Week ${w} · ${p.title}`}
        >
          <b>{w}</b><span>{formatShort(weekStart(w))}</span>
        </a>
      );
    })}
  </div>

  <div class="raillegend">
    {phases.map((p) => (
      <span><i style={`background:${band(p.band)}`}></i>W{p.weeks[0]}–{p.weeks[1]} · {p.title}</span>
    ))}
  </div>

  <h2 class="sec">The four phases</h2>
  <p class="sec-sub">Tap a week above to jump to its phase.</p>

  {phases.map((p) => {
    const current = isCurrentPhase(p);
    return (
      <section class:list={['phase', { current }]} id={`phase-${p.id}`} style={`--band:${band(p.band)}`}>
        <div class="phase-head">
          <span class="chip">Weeks {p.weeks[0]}–{p.weeks[1]}</span>
          <h3>{p.title}</h3>
          <span class="dates">{p.dates}</span>
        </div>
        <div class="blocks">
          {p.blocks.map((b) => (
            <div class="pblock">
              <div class="slot">{b.slot}</div>
              <h4>{b.name}</h4>
              {b.groups.map((g) => (
                <Fragment>
                  <div class="lead">{g.lead}</div>
                  <ul>{g.items.map((i) => <li>{i}</li>)}</ul>
                </Fragment>
              ))}
              {b.note && <p class="pnote">{b.note}</p>}
            </div>
          ))}
        </div>
      </section>
    );
  })}

  <h2 class="sec">Weekly rhythm</h2>
  <table class="rhythm">
    <thead><tr><th>Slot</th><th>Block</th><th>Runs</th></tr></thead>
    <tbody>
      {prep.rhythm.map((r) => (
        <tr><td>{r.slot}</td><td>{r.block}</td><td>{r.runs}</td></tr>
      ))}
    </tbody>
  </table>

  <div class="colophon">
    <span>{phases.length} phases · {prep.plannedWeeks}–{prep.maxWeeks} weeks · {prep.plannedSessions}+ weekday sessions</span>
    <span>from {formatShort(prep.startDate)} 2026</span>
  </div>
</Shell>
