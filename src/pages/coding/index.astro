---
import Shell from '~/layouts/Shell.astro';
import ProblemFilter from '~/components/react/ProblemFilter';
import { problems } from '~/data/problems';
import { sessionDates, allOpenItems } from '~/lib/content';
import { getCollection, render } from 'astro:content';
import { formatShort } from '~/lib/progress';
import { prep } from '../../../prep.config';
import { withBase } from '~/lib/base';

// "new" means "added in the most recent session" — derived, never written down.
const latest = (await sessionDates()).sort().at(-1) ?? null;

const rows = problems.map((p) => ({
  n: p.n,
  title: p.title,
  difficulty: p.difficulty,
  lc: p.lc,
  complexity: p.complexity,
  tags: p.tags ?? [],
  isNew: !!latest && p.traced === latest,
  traced: p.traced ?? null,
}));

// Backlog state is derived from the open-items, not written down.
const backlog = (await allOpenItems()).filter((o) => o.data.section === 'backlog');
const owed = backlog.filter((o) => o.data.status === 'open');
const lastCleared = backlog
  .filter((o) => o.data.status === 'closed')
  .map((o) => o.data.closed!)
  .sort()
  .at(-1);

const pages = await getCollection('pages');
const roadmap = pages.find((x) => x.id === 'coding-roadmap');
const Roadmap = roadmap ? (await render(roadmap)).Content : null;

const byDiff = (d: string) => problems.filter((p) => p.difficulty === d).length;
const totalFrames = problems.reduce((a, p) => a + p.trace().length, 0);
---
<Shell title="Coding" track="coding" description="Traced coding problems, step by step.">
  <p class="eyebrow">Track 02 · {prep.currentTopic.name}</p>
  <h1>{problems.length} problems,<br /><em>traced step by step</em>.</h1>
  <p class="lede">
    Pick a problem and scrub the timeline. The locals pane shows exactly the variables you would
    name while narrating, so stepping through is rehearsing the explanation.
  </p>

  <div class="metrics">
    <div class="metric"><div class="lb">Traced</div><div class="vv">{problems.length}</div><div class="sub">{totalFrames} frames in total</div></div>
    <div class="metric"><div class="lb">Easy</div><div class="vv">{byDiff('Easy')}</div><div class="sub">foundations</div></div>
    <div class="metric"><div class="lb">Medium</div><div class="vv">{byDiff('Medium')}</div><div class="sub">interview band</div></div>
    <div class="metric"><div class="lb">Hard</div><div class="vv">{byDiff('Hard')}</div><div class="sub">from week 7</div></div>
  </div>

  <div class="picker">
    {problems.map((p) => (
      <a class="pk" href={withBase(`/coding/${p.n}`)} title={p.title}>{String(p.n).padStart(2, '0')}</a>
    ))}
    {owed.length === 0 ? (
      <span
        class="pk todo"
        title={lastCleared ? `${backlog.at(-1)?.data.title.replace(/ — cleared$/, '')} cleared ${formatShort(lastCleared)} — nothing carried` : 'nothing carried'}
      >backlog · clear</span>
    ) : (
      <a class="pk todo" href={withBase('/open')} title={`${owed.length} owed`}>backlog · {owed.length}</a>
    )}
  </div>

  {Roadmap && <p class="stripnote" style="margin-top:-6px"><Roadmap /></p>}

  <ProblemFilter client:load rows={rows} />

  <div class="colophon">
    <span>{prep.currentTopic.name} · target {prep.currentTopic.target}</span>
    <span>Open any problem for the scrubbable trace</span>
  </div>
</Shell>
